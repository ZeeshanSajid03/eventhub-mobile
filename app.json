{
  "expo": {
    "name": "EventHub",
    "slug": "eventhub-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "eventhub",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.eventhub.mobile"
    },
    "ios": {
      "bundleIdentifier": "com.eventhub.mobile",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}